{
 "name": "@elsikora/nestjs-crud-config",
 "version": "5.0.0-dev.1",
 "description": "NestJS application configuration via database storage",
 "homepage": "https://github.com/ElsiKora/NestJS-Crud-Config#readme",
 "bugs": {
  "url": "https://github.com/ElsiKora/NestJS-Crud-Config/issues"
 },
 "repository": {
  "type": "git",
  "url": "https://github.com/ElsiKora/NestJS-Crud-Config"
 },
 "license": "MIT",
 "author": "ElsiKora",
 "sideEffects": false,
 "type": "module",
 "exports": {
  ".": {
   "types": "./dist/index.d.ts",
   "default": "./dist/index.js"
  }
 },
 "main": "./dist/index.js",
 "types": "./dist/index.d.ts",
 "files": [
  "dist"
 ],
 "scripts": {
  "branch": "npx @elsikora/git-branch-lint -b",
  "prebuild": "rimraf dist",
  "build": "npm run prebuild && rollup -c",
  "postbuild": "node scripts/check-declaration-imports.cjs",
  "commit": "cz",
  "format": "prettier --check .",
  "format:fix": "prettier --write .",
  "lint": "eslint ./",
  "lint:all": "npm run lint && npm run lint:types",
  "lint:all:fix": "npm run lint:fix && npm run lint:types:fix",
  "lint:fix": "eslint --fix ./",
  "lint:test": "eslint \"{src,apps,libs,test}/**/*.spec.ts\"",
  "lint:types": "tsc --noEmit",
  "lint:types:fix": "tsc --noEmit --skipLibCheck",
  "lint:watch": "npx eslint-watch ./",
  "prepare": "husky",
  "release": "semantic-release",
  "test:all": "npm run test:unit && npm run test:e2e",
  "test:consumer": "node scripts/test/consumer-smoke.mjs",
  "test:e2e": "npm run build && vitest --config vitest.end-to-end.config.js --typecheck.tsconfig tsconfig.json",
  "test:unit": "vitest run test/unit --config vitest.unit.config.js"
 },
 "config": {
  "commitizen": {
   "path": "@elsikora/commitizen-plugin-commitlint-ai"
  }
 },
 "dependencies": {
  "@nestjs/cache-manager": "^12.0.2",
  "cache-manager": "^7.2.9",
  "keyv": "^6.1.0",
  "lru-cache": "^11.5.3"
 },
 "devDependencies": {
  "@commitlint/cli": "^21.2.4",
  "@commitlint/config-conventional": "^21.2.4",
  "@elsikora/commitizen-plugin-commitlint-ai": "^3.0.1",
  "@elsikora/eslint-config": "^3.10.2",
  "@elsikora/eslint-plugin-nestjs-typed": "^3.1.0",
  "@elsikora/git-branch-lint": "^1.2.2",
  "@elsikora/nestjs-crud-automator": "^5.0.0-dev.5",
  "@fastify/static": "^10.1.8",
  "@nestjs/cli": "^12.0.11",
  "@nestjs/common": "^12.3.2",
  "@nestjs/core": "^12.3.2",
  "@nestjs/passport": "^12.0.0",
  "@nestjs/platform-fastify": "^12.3.2",
  "@nestjs/schematics": "^12.0.12",
  "@nestjs/swagger": "^12.0.5",
  "@nestjs/testing": "^12.3.2",
  "@nestjs/throttler": "^6.7.1",
  "@nestjs/typeorm": "^12.0.2",
  "@rollup/plugin-node-resolve": "^16.0.3",
  "@rollup/plugin-typescript": "^12.3.1",
  "@saithodev/semantic-release-backmerge": "^4.0.1",
  "@semantic-release/changelog": "^7.0.0",
  "@semantic-release/commit-analyzer": "^13.0.1",
  "@semantic-release/git": "^11.0.1",
  "@semantic-release/github": "^12.0.10",
  "@semantic-release/npm": "^13.2.0",
  "@semantic-release/release-notes-generator": "^14.1.1",
  "@swc/core": "^1.16.21",
  "@testcontainers/postgresql": "^12.2.1",
  "@types/node": "^26.6.6",
  "@vitest/coverage-v8": "^5.0.5",
  "@vitest/ui": "^5.0.5",
  "better-sqlite3": "^12.11.1",
  "class-transformer": "^0.5.1",
  "class-validator": "^0.15.1",
  "commitizen": "^4.3.2",
  "conventional-changelog-conventionalcommits": "^10.4.1",
  "eslint": "^10.14.0",
  "eslint-plugin-n": "^18.5.0",
  "eslint-plugin-ng-module-sort": "^1.4.0",
  "eslint-plugin-no-secrets": "^2.3.3",
  "eslint-plugin-typeorm-typescript": "^0.5.4",
  "fastify": "^5.12.7",
  "husky": "^9.1.7",
  "lint-staged": "^17.6.0",
  "lodash": "^4.18.1",
  "pg": "^8.23.1",
  "prettier": "^3.9.10",
  "reflect-metadata": "^0.2.2",
  "rimraf": "^6.1.3",
  "rollup": "^4.67.4",
  "rxjs": "^7.8.2",
  "semantic-release": "^25.0.9",
  "sql.js": "^1.15.2",
  "tslib": "^2.9.1",
  "typeorm": "^1.1.2",
  "typescript": "~6.0.3",
  "unplugin-dts": "^1.1.2",
  "unplugin-swc": "^2.0.0",
  "vite": "^8.3.5",
  "vite-tsconfig-paths": "^6.1.1",
  "vitest": "^5.0.5"
 },
 "peerDependencies": {
  "@elsikora/nestjs-crud-automator": "^5.0.0-dev.5",
  "@nestjs/common": "^12.3.2",
  "@nestjs/core": "^12.3.2",
  "@nestjs/passport": "^12.0.0",
  "@nestjs/platform-fastify": "^12.3.2",
  "@nestjs/swagger": "^12.0.0",
  "@nestjs/throttler": "^6.7.1",
  "@nestjs/typeorm": "^12.0.1",
  "class-transformer": "^0.5.1",
  "class-validator": "^0.15.1",
  "fastify": "^5.12.7",
  "lodash": "^4.18.1",
  "typeorm": "^1.1.2"
 },
 "engines": {
  "node": "^22.13.0 || >=24.11.0"
 },
 "publishConfig": {
  "access": "public"
 }
}
