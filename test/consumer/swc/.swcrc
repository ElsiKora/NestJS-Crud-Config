{
 "$schema": "https://swc.rs/schema.json",
 "jsc": {
  "keepClassNames": true,
  "parser": {
   "decorators": true,
   "dynamicImport": true,
   "syntax": "typescript"
  },
  "target": "es2023",
  "transform": {
   "decoratorMetadata": true,
   "legacyDecorator": true,
   "useDefineForClassFields": false
  }
 },
 "module": {
  "resolveFully": true,
  "type": "es6"
 },
 "sourceMaps": false
}
